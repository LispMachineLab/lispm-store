(require 'ert)
(require 'cl-lib)
(require 'seq)
(require 'subr-x)
(require 'rx)
(require 'erc)

;; Load the actual skill forms without optional packages, registration, UI or IO.
(defmacro lispm-deftool (name args _doc &rest body)
  (while (keywordp (car body)) (setq body (cddr body)))
  `(defun ,(intern (concat "lispm-store-test--" (symbol-name name)))
       (&optional ,@(mapcar #'car args) done)
     ,@body))

(let ((root (expand-file-name
             "../skills/"
             (file-name-directory
              (or load-file-name (bound-and-true-p byte-compile-current-file) buffer-file-name)))))
  (dolist (file '("chat-irc.org" "feeds.org" "blocks-world.org"))
    (with-temp-buffer
      (insert-file-contents (expand-file-name file root))
      (goto-char (point-min))
      (re-search-forward "^#\\+begin_src emacs-lisp.*\n")
      (let ((start (point)))
        (re-search-forward "^#\\+end_src")
        (let ((forms (buffer-substring-no-properties start (match-beginning 0))))
          (with-temp-buffer
            (insert forms)
            (goto-char (point-min))
            (condition-case nil
                (while t
                  (let ((form (read (current-buffer))))
                    (unless (eq (car-safe form) 'require) (eval form t))))
              (end-of-file nil))))))))

(ert-deftest lispm-store-runtime-irc-nickname-boundaries ()
  (dolist (nick '("[alice]" "`alice" "alice-" "a_b" "a\\b"))
    (should (lispm-irc--named-p nick (concat "hello " nick ": hi")))
    (should (lispm-irc--named-p nick nick))
    (should-not (lispm-irc--named-p nick (concat "x" nick)))
    (should-not (lispm-irc--named-p nick (concat nick "x"))))
  (should-not (lispm-irc--named-p "alice" "[alice]"))
  (should (lispm-irc--named-p "Alice" "ALICE!")))

(ert-deftest lispm-store-runtime-irc-network-and-preview ()
  (let ((a (generate-new-buffer " *irc-A*"))
        (b (generate-new-buffer " *irc-B*"))
        (chat (generate-new-buffer " *irc-chat*"))
        (queries 0))
    (unwind-protect
        (progn
          (with-current-buffer chat (setq major-mode 'erc-mode))
          (cl-letf (((symbol-function 'lispm-irc--server-of)
                     (lambda (network) (if (equal network "B") b a)))
                    ((symbol-function 'lispm-irc--server-p) (lambda (&optional _) nil))
                    ((symbol-function 'erc-server-buffer)
                     (lambda () (if (eq (current-buffer) chat) a (current-buffer))))
                    ((symbol-function 'erc-default-target) (lambda () "bob"))
                    ((symbol-function 'erc-server-process-alive) (lambda (&rest _) t))
                    ((symbol-function 'erc-channel-p) (lambda (&rest _) nil))
                    ((symbol-function 'erc-buffer-list) (lambda (&rest _) nil))
                    ((symbol-function 'erc-cmd-QUERY) (lambda (&rest _) (cl-incf queries)))
                    ((symbol-function 'lispm-irc--network)
                     (lambda (buffer) (if (eq buffer b) "B" "A")))
                    ((symbol-function 'lispm-irc--lines) (lambda (text) (list text))))
            (should-error (lispm-irc--send-target (buffer-name chat) "B"))
            (should-error (lispm-irc--send-preview (buffer-name chat) "hi" "B"))
            (should (eq (car (lispm-irc--send-target (buffer-name chat) "A")) chat))
            (should (equal (lispm-irc--send-target "bob" "B") (list nil b "bob")))
            (should (equal (lispm-irc--send-preview "bob" "hi" "B") "To bob on B:\n\nhi"))
            (should (= queries 0))))
      (mapc #'kill-buffer (list a b chat)))))

(defvar elfeed-db-entries)
(defvar elfeed-log-error-count)
(defvar lispm-feeds-update-timeout)
(declare-function lispm-irc--named-p nil (nick text))
(declare-function lispm-irc--send-target nil (to &optional network))
(declare-function lispm-irc--send-preview nil (to text &optional network))
(declare-function lispm-store-test--feeds_update nil (&optional done))
(declare-function lispm-store-test--shrdlu_say nil (&optional sentence done))
(ert-deftest lispm-store-runtime-feeds-update-pending ()
  (let ((elfeed-db-entries (make-hash-table)) (elfeed-log-error-count 0)
        (queue 1) (updated 0) (saved 0) (cancelled 0) callback replies)
    (cl-letf (((symbol-function 'elfeed-db-ensure) #'ignore)
              ((symbol-function 'elfeed-feed-list) (lambda (&rest _) '(a b c)))
              ((symbol-function 'elfeed-queue-count-total) (lambda () queue))
              ((symbol-function 'elfeed-update) (lambda () (cl-incf updated) (setq queue 3)))
              ((symbol-function 'elfeed-db-save) (lambda () (cl-incf saved)))
              ((symbol-function 'run-at-time)
               (lambda (_time _repeat fn &rest _) (setq callback fn) 'fake-timer))
              ((symbol-function 'cancel-timer) (lambda (_) (cl-incf cancelled))))
      (lispm-store-test--feeds_update (lambda (&rest reply) (push reply replies)))
      (should (= updated 1))
      (funcall callback)
      (should-not replies)
      (puthash 'new t elfeed-db-entries)
      (setq queue 0)
      (funcall callback)
      (funcall callback)
      (should (= (length replies) 1))
      (should (equal (caar replies) "Update queue finished for 3 feeds: 1 new entries."))
      (should (= saved 1))
      (should (= cancelled 1)))))

(ert-deftest lispm-store-runtime-feeds-timeout-and-empty ()
  (let ((elfeed-db-entries (make-hash-table)) (elfeed-log-error-count 2)
        (lispm-feeds-update-timeout -1) callback replies (cancelled 0) (updated 0))
    (cl-letf (((symbol-function 'elfeed-db-ensure) #'ignore)
              ((symbol-function 'elfeed-feed-list) (lambda (&rest _) '(a)))
              ((symbol-function 'elfeed-queue-count-total) (lambda () 1))
              ((symbol-function 'elfeed-update) (lambda () (cl-incf updated)))
              ((symbol-function 'elfeed-db-save) #'ignore)
              ((symbol-function 'run-at-time)
               (lambda (_time _repeat fn &rest _) (setq callback fn) 'fake-timer))
              ((symbol-function 'cancel-timer) (lambda (_) (cl-incf cancelled))))
      (lispm-store-test--feeds_update (lambda (&rest reply) (push reply replies)))
      (funcall callback)
      (funcall callback)
      (should (= cancelled 1))
      (should (= (length replies) 1))
      (should (string-match-p "Still fetching.*2 errors" (caar replies)))
      (cl-letf (((symbol-function 'elfeed-feed-list) (lambda (&rest _) nil)))
        (lispm-store-test--feeds_update (lambda (&rest reply) (push reply replies))))
      (should (= updated 1))
      (should (= (length replies) 2)))))

(ert-deftest lispm-store-runtime-shrdlu-lifecycle ()
  (dolist (mode '(sync async ask-error show-error timeout))
    (let ((cancelled 0) callback timer-callback replies)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time _repeat fn &rest args)
                   (setq timer-callback (lambda () (apply fn args))) 'fake-timer))
                ((symbol-function 'cancel-timer) (lambda (_) (cl-incf cancelled)))
                ((symbol-function 'lispm-shrdlu-ask)
                 (lambda (_sentence fn)
                   (setq callback fn)
                   (cond ((eq mode 'sync) (funcall fn "OK"))
                         ((eq mode 'ask-error) (error "Cannot start")))
                   'fake-buffer))
                ((symbol-function 'lispm-blocks-world-show)
                 (lambda (_) (when (eq mode 'show-error) (error "Cannot display")))))
        (lispm-store-test--shrdlu_say "hello" (lambda (&rest reply) (push reply replies)))
        (when (eq mode 'async) (funcall callback "OK"))
        (when (eq mode 'timeout) (funcall timer-callback))
        (should (= cancelled 1))
        (should (= (length replies) 1))
        (when (memq mode '(ask-error show-error timeout)) (should (cadar replies)))
        (funcall callback "late")
        (funcall timer-callback)
        (should (= (length replies) 1))
        (should (= cancelled 1))))))

(provide 'lispm-store-runtime-test)
